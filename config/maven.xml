<project xmlns="http://maven.apache.org/POM/4.0.0">
    <!--...-->
    <dependencies>
        <!--JSpecify should already be provided-->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <!--NullAway options-->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <!--Note: Error Prone/NullAway flags need to be in the same arg tag-->
                        <arg>
                            <!--Disable all checks except NullAway-->
                            -Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR
                            <!--Use -Xep:NullAway:WARN if test code/examples are still raising warnings-->

                            <!--Only checked null-marked code or desired packages-->
                            -XepOpt:NullAway:OnlyNullMarked
                            <!--or -XepOpt:NullAway:AnnotatedPackages=package1,package2-->

                            <!--JSpecify support-->
                            -XepOpt:NullAway:JSpecifyMode=true
                            <!--Add -XepOpt:NullAway:AssertsEnabled=true to enable asserts (disabled by default)-->

                            <!--Disable checks on test code-->
                            -XepExcludedPaths:.*/test/.*
                        </arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                    </compilerArgs>

                    <!--NullAway + Error Prone compiler plugins-->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>2.48.0</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>0.13.1</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>